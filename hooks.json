{
  "astack-receipt-ledger": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content|run_command|invoke_subagent|run_workflow|call_mcp_tool|mcp_.*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hooks/receipt-ledger.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "astack-session-context": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/hooks/session-context.mjs",
        "timeout": 5
      }
    ]
  },
  "astack-pr-intent": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/hooks/pr-intent.mjs",
        "timeout": 5
      }
    ]
  },
  "astack-irreversible-guard": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hooks/irreversible-guard.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "astack-secret-guard": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hooks/secret-guard.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "astack-verify-reminder": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "node ./scripts/hooks/verify-reminder.mjs --dirty-only",
        "timeout": 10
      }
    ]
  },
  "astack-evidence-gate": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "run_command|call_mcp_tool|mcp_.*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hooks/evidence-gate.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "astack-boundary-guard": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hooks/boundary-guard.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "astack-round-limiter": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hooks/round-limiter.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "astack-trust-gate": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content|run_command|call_mcp_tool|mcp_.*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hooks/trust-gate.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
